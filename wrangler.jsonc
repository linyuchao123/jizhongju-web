{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jizhongju",
  "account_id": "76783b5c6142a40b85a2d8c4de542e30",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "ai": {"binding":"AI"},
  "routes": [{"pattern":"jizhongju.xiaolinyx.me","custom_domain":true}],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{"binding":"DB","database_name":"jizhongju-accounts","database_id":"0175c1b2-6449-413d-b658-e956561fb799"}]
}
